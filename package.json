{
  "name": "proyecto-indumentaria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:indumentaria": "vite build --base=/indumentaria/",
    "build:local": "vite build --base=./",
    "build:desktop": "npm run build:local && electron-builder --win --x64",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173",
    "package:desktop": "npm run build:local && electron-builder --win --x64"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^10.12.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.monognomo.proyectoindumentaria",
    "productName": "Proyecto Indumentaria",
    "icon": "icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
